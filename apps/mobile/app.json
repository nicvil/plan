{
  "expo": {
    "name": "LinkIQ",
    "slug": "linkiq",
    "scheme": "linkiq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f13"
    },
    "ios": {
      "bundleIdentifier": "app.linkiq.ios",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan QR codes",
        "NSPhotoLibraryUsageDescription": "Used to save and upload QR code images"
      }
    },
    "android": {
      "package": "app.linkiq.android",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366f1"
      },
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LinkIQ to access your camera to scan QR codes"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6366f1"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to upload QR code logos"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
