generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String?
  image           String?
  password        String?
  plan            Plan              @default(FREE)
  pushToken       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  workspaces      WorkspaceMember[]
  ownedWorkspaces Workspace[]
  refreshTokens   RefreshToken[]
  accounts        Account[]
  sessions        Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  slug      String            @unique
  logo      String?
  ownerId   String
  owner     User              @relation(fields: [ownerId], references: [id])
  members   WorkspaceMember[]
  links     Link[]
  domains   Domain[]
  createdAt DateTime          @default(now())
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(MEMBER)
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
}

model Domain {
  id          String    @id @default(cuid())
  domain      String    @unique
  verified    Boolean   @default(false)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  links       Link[]
  createdAt   DateTime  @default(now())
}

model Link {
  id             String     @id @default(cuid())
  slug           String
  destinationUrl String
  title          String?
  description    String?
  password       String?
  expiresAt      DateTime?
  workspaceId    String
  domainId       String?
  workspace      Workspace  @relation(fields: [workspaceId], references: [id])
  domain         Domain?    @relation(fields: [domainId], references: [id])
  clicks         Click[]
  utmParams      UTMParams?
  qrCode         QRCode?
  tags           Tag[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([slug, domainId])
}

model UTMParams {
  id       String  @id @default(cuid())
  linkId   String  @unique
  link     Link    @relation(fields: [linkId], references: [id])
  source   String?
  medium   String?
  campaign String?
  term     String?
  content  String?
}

model QRCode {
  id      String  @id @default(cuid())
  linkId  String  @unique
  link    Link    @relation(fields: [linkId], references: [id])
  fgColor String  @default("#000000")
  bgColor String  @default("#FFFFFF")
  logo    String?
  size    Int     @default(300)
  fileUrl String?
}

model Click {
  id        String   @id @default(cuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id])
  ip        String?
  country   String?
  city      String?
  device    String?
  os        String?
  browser   String?
  referrer  String?
  clickedAt DateTime @default(now())
}

model Tag {
  id    String @id @default(cuid())
  name  String
  color String @default("#6366f1")
  links Link[]
}

enum Plan {
  FREE
  PRO
  GROWTH
  TEAM
  ENTERPRISE
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}
