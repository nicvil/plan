# ===========================================
# LinkIQ — Local Development Configuration
# ===========================================
# Copy this file:  cp .env.example .env
# The defaults below work with docker-compose.yml

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql://linkiq:linkiq@localhost:5432/linkiq

# ---------- Cache (Redis) ----------
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
# Generate secrets: openssl rand -base64 32
NEXTAUTH_SECRET=local-dev-secret-change-in-production
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=local-dev-jwt-secret-change-in-production

# ---------- OAuth (optional for local dev) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Stripe (optional for local dev) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------- Email / Resend (optional for local dev) ----------
RESEND_API_KEY=

# ---------- Storage / Cloudflare R2 (optional for local dev) ----------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
